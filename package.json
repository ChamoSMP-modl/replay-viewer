{
  "name": "@chamosmp-net/replay-viewer",
  "version": "1.16.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "generate-atlas": "node scripts/generate-atlas.mjs",
    "generate-atlas:all": "node scripts/generate-all-atlases.mjs",
    "prebuild": "npm run generate-atlas:all",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "publish": "npm publish --access public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "minecraft-assets": "^1.19.0",
    "minecraft-data": "^3.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "registry": "https://nexus.modl.gg/repository/npm-releases/"
  },
  "description": "A web replay viewer library for Minecraft using modl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChamoSMP-modl/replay-viewer.git"
  },
  "keywords": [
    "replay",
    "minecraft"
  ],
  "author": "ChamoSMP Developers",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/ChamoSMP-modl/replay-viewer/issues"
  },
  "homepage": "https://github.com/ChamoSMP-modl/replay-viewer#readme"
}
